generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum Severity { info warning critical }
enum IncidentStatus { OPEN INVESTIGATING MITIGATED RESOLVED }
model User { id String @id @default(uuid()) @db.Uuid email String @unique name String passwordHash String @map("password_hash") createdAt DateTime @default(now()) @map("created_at") @@map("users") }
model Service { id String @id @default(uuid()) @db.Uuid name String @unique displayName String @map("display_name") team String environment String healthScore Float @map("health_score") metadata Json createdAt DateTime @default(now()) @map("created_at") telemetry TelemetryEvent[] logs LogEntry[] anomalies Anomaly[] incidents Incident[] @@map("services") }
model TelemetryEvent { id String @id @default(uuid()) @db.Uuid serviceId String @db.Uuid @map("service_id") service Service @relation(fields:[serviceId],references:[id]) metric String value Float unit String attributes Json timestamp DateTime @default(now()) @@index([serviceId,timestamp]) @@map("telemetry_events") }
model LogEntry { id String @id @default(uuid()) @db.Uuid serviceId String @db.Uuid @map("service_id") service Service @relation(fields:[serviceId],references:[id]) level String message String traceId String? @map("trace_id") attributes Json timestamp DateTime @default(now()) embedding LogEmbedding? @@index([serviceId,timestamp]) @@map("log_entries") }
model LogEmbedding { id String @id @default(uuid()) @db.Uuid logId String @unique @db.Uuid @map("log_id") log LogEntry @relation(fields:[logId],references:[id],onDelete:Cascade) embedding Unsupported("vector(768)") model String createdAt DateTime @default(now()) @map("created_at") @@map("log_embeddings") }
model Anomaly { id String @id @default(uuid()) @db.Uuid serviceId String @db.Uuid @map("service_id") service Service @relation(fields:[serviceId],references:[id]) metric String score Float severity Severity reason String category String value Float baseline Float acknowledged Boolean timestamp DateTime @default(now()) incidents Incident[] @@index([serviceId,timestamp]) @@map("anomalies") }
model Incident { id String @id @default(uuid()) @db.Uuid title String serviceId String @db.Uuid @map("service_id") service Service @relation(fields:[serviceId],references:[id]) anomalyId String? @db.Uuid @map("anomaly_id") anomaly Anomaly? @relation(fields:[anomalyId],references:[id]) severity Severity status IncidentStatus openedAt DateTime @default(now()) @map("opened_at") resolvedAt DateTime? @map("resolved_at") notes IncidentNote[] summaries IncidentSummary[] @@map("incidents") }
model IncidentNote { id String @id @default(uuid()) @db.Uuid incidentId String @db.Uuid @map("incident_id") incident Incident @relation(fields:[incidentId],references:[id],onDelete:Cascade) author String body String createdAt DateTime @default(now()) @map("created_at") @@map("incident_notes") }
model IncidentSummary { id String @id @default(uuid()) @db.Uuid incidentId String @db.Uuid @map("incident_id") incident Incident @relation(fields:[incidentId],references:[id],onDelete:Cascade) summary String rootCause String @map("root_cause") recommendedActions Json @map("recommended_actions") confidence Float model String createdAt DateTime @default(now()) @map("created_at") @@map("incident_summaries") }
model KafkaMetric { id String @id @default(uuid()) @db.Uuid topic String eventsPerSecond Float @map("events_per_second") throughputBytes Float @map("throughput_bytes") consumerLag Int @map("consumer_lag") utilization Float timestamp DateTime @default(now()) @@map("kafka_metrics") }
